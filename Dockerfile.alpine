FROM alpine:latest


RUN apk update && apk add --no-cache \
    curl \
    gnupg \
    lsb-release \
    ca-certificates \
    iproute2 \
    dbus \
    procps \
    net-tools \
    iptables \
    redsocks \
    dos2unix \
    coreutils \
    socat \
    && rm -rf /var/cache/apk/*

RUN apk add --no-cache binutils \
    && WARP_DEB_URL=$( \
         curl -fsSL "https://pkg.cloudflareclient.com/dists/noble/main/binary-amd64/Packages.gz" \
         | gunzip | grep -m1 '^Filename: ' | awk '{print $2}' \
       ) \
    && curl -fsSL -o /tmp/warp.deb "https://pkg.cloudflareclient.com/$WARP_DEB_URL" \
    && mkdir -p /tmp/warp-extract && cd /tmp/warp-extract \
    && ar x /tmp/warp.deb && tar xf data.tar.* -C / \
    && rm -rf /tmp/warp* \
    && apk del binutils

WORKDIR /app
COPY *.sh /app/
RUN dos2unix /app/*.sh && chmod +x /app/*.sh

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
  CMD timeout 3 bash -c 'echo >/dev/tcp/127.0.0.1/40000' 2>/dev/null || exit 1

ENTRYPOINT ["/bin/bash"]
